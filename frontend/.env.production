# Production build configuration (safe, non-secret values, committed on purpose).
# The browser calls the API at the SAME origin; vercel.json proxies /api and
# /socket.io to the Express backend configured by BACKEND_URL in Vercel.
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/socket.io
VITE_APP_NAME=Team Algebra Club Tracker
