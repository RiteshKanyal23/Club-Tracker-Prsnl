# LOCAL DEVELOPMENT example (copy to .env for local `npm run dev`).
# NEVER use localhost for production/Vercel - browsers would call the
# visitor's own machine. Production values live in .env.production and in the
# Vercel dashboard. See docs/production-deployment.md.
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000
VITE_APP_NAME=Team Algebra Club Tracker
