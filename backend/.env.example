NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/team_algebra?schema=public

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# CORS / App
# Local development defaults. In production set CORS_ORIGIN to the EXACT Vercel
# origin(s), comma-separated (e.g. https://your-app.vercel.app). Never use "*"
# together with credentials.
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# In production, when the frontend and backend are on different sites, set:
# COOKIE_SAME_SITE=none  (COOKIE_SECURE=true is automatic for NODE_ENV=production)

# Registration / Security
# Required for /admin/signup (server-side validated). Do not expose publicly.
ADMIN_INVITE_CODE=

# Email (SMTP)
# Leave SMTP_HOST unset for local dev: emails are logged to backend console as [email:mock].
# To deliver real verification/reset emails, configure a provider SMTP (example: Gmail/Resend/etc).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Team Algebra Club Tracker <noreply@teamalgebra.local>"

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
