generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  CEO
  ADMIN
  COORDINATOR
  PROJECT_MANAGER
  TEAM_LEADER
  MEMBER
}

enum TeamCategory {
  FRONTEND
  BACKEND
  DATABASE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  adminId       String?   @unique
  ceoSlot       String?   @unique
  role          RoleName  @default(MEMBER)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  memberProfile Member?
  auditLogs     AuditLog[] @relation("AuditActor")
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  userRoles     UserRole[]
  channelMembers ChannelMember[]
  messages       Message[] @relation("MessageSender")
  announcementReceipts AnnouncementReceipt[]
  notifications  Notification[]
  notificationPreference NotificationPreference?
  knowledgeArticles KnowledgeArticle[] @relation("ArticleAuthor")
  feedbackGiven     Feedback[] @relation("FeedbackFrom")
  feedbackReceived  Feedback[] @relation("FeedbackTo")
  attendanceMarked  AttendanceRecord[] @relation("AttendanceMarkedBy")
  managedProject    Project?   @relation("ProjectManager")
  managedAssignments OrgAssignment[] @relation("AssignmentProjectManager")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      TokenType
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

model Member {
  id              String              @id @default(cuid())
  userId          String              @unique
  memberId        String?             @unique
  phone           String?
  teamName        String?
  profilePicture  String?
  joiningDate     DateTime?
  status          MemberStatus        @default(ACTIVE)
  bio             String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  user            User                @relation(fields: [userId], references: [id])
  skills          MemberSkill[]
  teamLinks       TeamMember[]
  taskAssignments TaskAssignee[]
  attendance      AttendanceRecord[]
  leaveRequests   LeaveRequest[]
  leaveBalance    LeaveBalance?
  achievements    MemberAchievement[]
  orgAssignments  OrgAssignment[]     @relation("MemberOrgAssignments")
  ledAssignments  OrgAssignment[]     @relation("AssignmentTeamLead")
  ledTeams        Team[]              @relation("TeamLeader")
}

model Team {
  id              String         @id @default(cuid())
  name            String
  description     String?
  leaderId        String?
  leaderMemberId  String?        @unique
  category        TeamCategory?
  projectId       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  leaderMember    Member?        @relation("TeamLeader", fields: [leaderMemberId], references: [id], onDelete: SetNull)
  project         Project?       @relation("OrgTeams", fields: [projectId], references: [id], onDelete: SetNull)
  members         TeamMember[]
  projects        ProjectTeam[]
  orgAssignments  OrgAssignment[]

  @@unique([projectId, category])
  @@index([projectId, category, deletedAt])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  memberId  String
  joinedAt  DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id])
  member    Member   @relation(fields: [memberId], references: [id])

  @@unique([teamId, memberId])
  @@index([memberId])
}

model Project {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      ProjectStatus    @default(PLANNING)
  orgSlot     Int?             @unique
  managerId   String?          @unique
  deadline    DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  manager     User?            @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  teams       ProjectTeam[]
  orgTeams    Team[]           @relation("OrgTeams")
  orgAssignments OrgAssignment[]
  tasks       Task[]
  milestones  Milestone[]
  history     ProjectHistory[]

  @@index([status, deadline])
}

model ProjectHistory {
  id        String   @id @default(cuid())
  projectId String
  actorId   String?
  action    String
  details   Json?
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model ProjectTeam {
  projectId String
  teamId    String
  project   Project @relation(fields: [projectId], references: [id])
  team      Team    @relation(fields: [teamId], references: [id])

  @@id([projectId, teamId])
}

model Designation {
  id                  String             @id @default(cuid())
  key                 String             @unique
  name                String             @unique
  description         String?
  isBuiltIn           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  assignments         OrgAssignment[]
  attendanceSnapshots AttendanceRecord[] @relation("AttendanceDesignation")
}

model OrgAssignment {
  id               String            @id @default(cuid())
  memberId         String
  designationId    String
  projectId        String?
  teamId           String?
  teamLeadId       String?
  projectManagerId String?
  status           MemberStatus      @default(ACTIVE)
  activeKey        String?           @unique
  effectiveFrom    DateTime          @default(now())
  effectiveTo      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  member           Member            @relation("MemberOrgAssignments", fields: [memberId], references: [id], onDelete: Cascade)
  designation      Designation       @relation(fields: [designationId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team             Team?             @relation(fields: [teamId], references: [id], onDelete: SetNull)
  teamLead         Member?           @relation("AssignmentTeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  projectManager   User?             @relation("AssignmentProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  attendanceRecords AttendanceRecord[] @relation("AttendanceAssignment")

  @@index([memberId, status, effectiveFrom])
  @@index([projectId, teamId, status])
}

model Task {
  id          String       @id @default(cuid())
  projectId   String
  milestoneId String?
  parentId    String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  project     Project      @relation(fields: [projectId], references: [id])
  milestone   Milestone?   @relation(fields: [milestoneId], references: [id])
  parent      Task?        @relation("TaskSubtasks", fields: [parentId], references: [id])
  subtasks    Task[]       @relation("TaskSubtasks")
  assignees   TaskAssignee[]
  comments    TaskComment[]

  @@index([projectId, status, order])
  @@index([milestoneId])
  @@index([parentId])
}

model TaskAssignee {
  taskId   String
  memberId String
  task     Task   @relation(fields: [taskId], references: [id])
  member   Member @relation(fields: [memberId], references: [id])

  @@id([taskId, memberId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  content   String
  mentions  String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  title       String
  description String?
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  project     Project   @relation(fields: [projectId], references: [id])
  tasks       Task[]

  @@index([projectId, dueDate])
}

model MemberSkill {
  id          String @id @default(cuid())
  memberId    String
  name        String
  proficiency Int
  member      Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, name])
  @@index([name, proficiency])
}

model AttendanceRecord {
  id                  String           @id @default(cuid())
  memberId            String
  date                DateTime
  sessionName         String?          // lab session name
  status              AttendanceStatus @default(PRESENT)
  checkIn             DateTime?
  checkOut            DateTime?
  notes               String?
  photoPath           String?
  markedById          String?
  memberIdText        String?
  memberName          String?
  projectName         String?
  projectManagerName  String?
  teamName            String?
  teamLeadName        String?
  designationName     String?
  assignmentId        String?
  designationId       String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  member              Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  markedBy            User?            @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  assignment          OrgAssignment?   @relation("AttendanceAssignment", fields: [assignmentId], references: [id], onDelete: SetNull)
  designation         Designation?     @relation("AttendanceDesignation", fields: [designationId], references: [id], onDelete: SetNull)

  @@index([memberId, date])
  @@index([date, sessionName])
  @@index([memberIdText, date])
  @@index([date, projectName])
  @@index([date, teamName])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  memberId   String
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  remarks    String?
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  member     Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status, startDate])
}

model LeaveBalance {
  id        String   @id @default(cuid())
  memberId  String   @unique
  year      Int
  total     Int      @default(20)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Meeting {
  id          String         @id @default(cuid())
  title       String
  agenda      String?
  scheduledAt DateTime
  location    String?
  teamId      String?
  projectId   String?
  createdBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  minutes     MeetingMinutes?
  actionItems ActionItem[]

  @@index([scheduledAt])
  @@index([teamId])
  @@index([projectId])
}

model MeetingMinutes {
  id        String   @id @default(cuid())
  meetingId String   @unique
  content   String
  recordedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
}

model ActionItem {
  id          String    @id @default(cuid())
  meetingId   String
  title       String
  description String?
  assigneeId  String?
  dueDate     DateTime?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, DONE
  taskId      String?   // linked task when converted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
}

model Announcement {
  id          String                @id @default(cuid())
  title       String
  content     String
  pinned      Boolean               @default(false)
  targetRoles String[]              @default([])
  targetTeams String[]              @default([])
  createdBy   String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  receipts    AnnouncementReceipt[]
}

model AnnouncementReceipt {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

enum ChannelType {
  TEAM
  PROJECT
  GENERAL
}

model Channel {
  id          String          @id @default(cuid())
  name        String
  type        ChannelType
  teamId      String?
  projectId   String?
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  members     ChannelMember[]
  messages    Message[]

  @@index([type, teamId, projectId])
}

model ChannelMember {
  id          String   @id @default(cuid())
  channelId   String
  userId      String
  lastReadAt  DateTime?
  joinedAt    DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

model Message {
  id          String   @id @default(cuid())
  channelId   String
  senderId    String
  content     String
  fileName    String?
  filePath    String?
  fileMime    String?
  createdAt   DateTime @default(now())
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channelId, createdAt])
}

model KnowledgeArticle {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String?
  tags        String[] @default([])
  authorId    String?
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation("ArticleAuthor", fields: [authorId], references: [id])

  @@index([category])
}

enum NotificationType {
  INFO
  TASK
  MEETING
  LEAVE
  ANNOUNCEMENT
  SYSTEM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String?
  data      Json?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  inApp      Boolean  @default(true)
  email      Boolean  @default(true)
  taskUpdates Boolean @default(true)
  meetingReminders Boolean @default(true)
  announcements Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  parentId  String?
  projectId String?
  teamId    String?
  createdBy String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@index([parentId])
  @@index([projectId])
  @@index([teamId])
}

model Document {
  id          String            @id @default(cuid())
  title       String
  folderId    String?
  projectId   String?
  teamId      String?
  accessRoles String[]          @default([])
  createdBy   String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  folder      DocumentFolder?   @relation(fields: [folderId], references: [id])
  versions    DocumentVersion[]

  @@index([folderId])
  @@index([projectId, teamId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedBy   String?
  createdAt    DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

model Achievement {
  id          String              @id @default(cuid())
  name        String              @unique
  description String?
  criteriaKey String?
  icon        String?
  points      Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  awards      MemberAchievement[]
}

model MemberAchievement {
  id            String      @id @default(cuid())
  memberId      String
  achievementId String
  awardedBy     String?
  note          String?
  awardedAt     DateTime    @default(now())
  member        Member      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([memberId, achievementId])
  @@index([awardedAt])
}

enum FeedbackStatus {
  OPEN
  REVIEWED
  RESOLVED
}

model Feedback {
  id         String         @id @default(cuid())
  fromUserId String
  toUserId   String?
  projectId  String?
  taskId     String?
  rating     Int?
  comment    String
  status     FeedbackStatus @default(OPEN)
  response   String?
  reviewedBy String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  fromUser   User           @relation("FeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User?          @relation("FeedbackTo", fields: [toUserId], references: [id])

  @@index([fromUserId, createdAt])
  @@index([toUserId, status])
  @@index([projectId, taskId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
}
